{
  "Server": {
    "ThreadCount": 2,
    "InboxCapacity": 1024,
    "RingReplicas": 64,
    "QuantumMilliseconds": 10,
    "PriorityQueues": true,
    "Games": ["demo"],
    "AllowedCommands": ["CreateItem", "FleetOrder"],
    "CommandTargets": { "CreateItem": "id", "FleetOrder": "id" },
    "Players": {},
    "ItemKinds": {
      "Ship": ["Fuel", "Owner"],
      "Projectile": ["Owner", "Position", "Direction", "Speed", "Damage", "Destroyed", "Velocity"]
    },
    "SnapshotOnStop": true,
    "RestoreOnStart": true,
    "SnapshotPath": "data/server-snapshot.json",
    "JwtIssuer": "SpaceBattle",
    "JwtAudience": "Players"
  },
  "PlayerPrograms": {
    "Limits": { "SourceBytes": 65536, "OutputBytes": 16384, "JsonDepth": 8 },
    "Docker": {
      "Executable": "docker",
      "ParallelRuns": 2,
      "ExecutionTimeout": "00:00:10",
      "CleanupTimeout": "00:00:05",
      "StreamDrainTimeout": "00:00:01",
      "MemoryMiB": 128,
      "TmpfsMiB": 8,
      "ProcessLimit": 32,
      "Cpus": 1,
      "UserId": 65534,
      "GroupId": 65534
    },
    "Languages": ["Python", "JavaScript"],
    "Python": {
      "Name": "python",
      "Image": "python:3.12-alpine",
      "EntryPoint": "python",
      "Bootstrap": "PlayerPrograms/Bootstraps/python.py",
      "Arguments": ["-I", "-B", "-c"]
    },
    "JavaScript": {
      "Name": "javascript",
      "Image": "node:22-alpine",
      "EntryPoint": "node",
      "Bootstrap": "PlayerPrograms/Bootstraps/javascript.cjs",
      "Arguments": ["-e"]
    }
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } }
}
