{
  "Server": {
    "ThreadCount": 2,
    "InboxCapacity": 1024,
    "RingReplicas": 64,
    "QuantumMilliseconds": 10,
    "PriorityQueues": true,
    "Games": ["demo"],
    "AllowedCommands": ["CreateItem"],
    "ItemKinds": { "Ship": ["Fuel", "Owner"] },
    "SnapshotOnStop": true,
    "RestoreOnStart": true,
    "SnapshotPath": "data/server-snapshot.json",
    "JwtIssuer": "SpaceBattle",
    "JwtAudience": "Players"
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } }
}
