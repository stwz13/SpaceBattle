<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
        <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Config\*.config" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="core">
            <HintPath>..\Assemblies\core.dll</HintPath>
        </Reference>
        <Reference Include="scopes">
            <HintPath>..\Assemblies\scopes.dll</HintPath>
        </Reference>
    </ItemGroup>

</Project>
